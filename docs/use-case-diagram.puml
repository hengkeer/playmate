@startuml PlayMate_UseCase_Diagram
!theme plain
title PlayMate — Use Case Diagram
top to bottom direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam defaultTextAlignment center
skinparam linetype ortho

' ============================================
' ACTORS
' ============================================

actor Guest
actor Player
actor Host
actor Admin

' ============================================
' SYSTEM BOUNDARY
' ============================================

rectangle "PlayMate System" {

  ' Row 1: Auth + Profile + Matchmaking
  package "Authentication" {
    usecase "Register" as UC01
    usecase "Login" as UC02
    usecase "Logout" as UC03
  }

  package "Profile" {
    usecase "Manage Profile" as UC10
    usecase "Manage Sports" as UC12
  }

  package "Matchmaking" {
    usecase "Find Opponents" as UC20
    usecase "Filter Results" as UC21
    usecase "Challenge Player" as UC27
  }

  ' Row 2: Connections + Events + Chat
  package "Connections" {
    usecase "Connect / Accept / Decline" as UC30
    usecase "View Connections" as UC33
    usecase "Block Player" as UC34
  }

  package "Events" {
    usecase "Browse Events" as UC40
    usecase "Manage Event" as UC42
    usecase "Manage Host Requests" as UC50
  }

  package "Chat" {
    usecase "Event Group Chat" as UC60
    usecase "Private Chat" as UC64
  }

  ' Row 3: Reviews + Venues + Admin
  package "Reviews" {
    usecase "Write / View Reviews" as UC70
  }

  package "Venues" {
    usecase "Browse Venues" as UC80
    usecase "View Venue Detail" as UC81
  }

  package "Admin" {
    usecase "Manage Data" as UC90
  }
}

' ============================================
' ACTOR INHERITANCE
' ============================================
Host -|> Player

' ============================================
' RELATIONSHIPS
' ============================================
UC27 .down.> UC42 : <<extends>>
UC60 .up.> UC40 : <<includes>>
UC50 .down.> UC40 : <<extends>>

' ============================================
' GUEST -> USE CASES
' ============================================
note right of Guest
  Guest is an unauthenticated user
end note
Guest --> UC01
Guest --> UC02
Guest --> UC80
Guest --> UC81
Guest --> UC40

' ============================================
' PLAYER -> USE CASES
' ============================================
note right of Player
  All authenticated users
end note
Player --> UC02
Player --> UC03
Player --> UC10
Player --> UC12
Player --> UC20
Player --> UC21
Player --> UC34
Player --> UC70
Player --> UC80
Player --> UC81

Player --> UC30
Player --> UC33

Player --> UC40
Player --> UC42
Player --> UC50

Player --> UC60
Player --> UC64

Player --> UC27

' ============================================
' HOST -> USE CASES
' ============================================
note right of Host
  Host is a Player who creates events
end note
Host --> UC50

' ============================================
' ADMIN -> USE CASES
' ============================================
note right of Admin
  System administrator
end note
Admin --> UC90

@enduml
