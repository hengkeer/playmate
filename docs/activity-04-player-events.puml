@startuml activity-04-player-events
title Player - Join Event & Group Chat
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontName Arial
  FontSize 11
  DiamondBackgroundColor #BBDEFB
  DiamondBorderColor #1565C0
  ArrowColor #0D47A1
}

|Player|
start
:Browse Events;
:Pilih event & lihat detail;

if (Join event?) then (ya)
  |System|
  if (approval_required?) then (ya)
    :Set status pending;
    :Tunggu approval dari host;
  else (tidak)
    :Set status approved\nsecara otomatis;
  endif
  |Player|
  :Masuk Event Group Chat;
  :Kirim pesan / gambar / file;
else (Leave event?)
  |System|
  :Hapus partisipasi pemain;
endif

|Player|
stop

@enduml
