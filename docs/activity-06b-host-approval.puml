@startuml activity-06b-host-approval
title Host - Approval Pending Participant
skinparam activity {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontName Arial
  FontSize 11
  DiamondBackgroundColor #FFE0B2
  DiamondBorderColor #E65100
  ArrowColor #BF360C
}

|System|
start
:Status participant = pending\n(lanjutan dari activity-06a);

|Host|
:Buka halaman Host Requests;
if (Approve participant?) then (ya)
  :Klik Approve;
  |System|
  :Set status approved,\nassign slot, post system message;
else (tidak)
  |Host|
  :Klik Reject;
  |System|
  :Set status rejected,\npost system message;
endif

|Participant|
:Masuk Event Group Chat;
stop

@enduml
