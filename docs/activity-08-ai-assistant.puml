@startuml activity-08-ai-assistant
title Player - AI Assistant (RAG Chatbot)
skinparam activity {
  BackgroundColor #E0F2F1
  BorderColor #00695C
  FontName Arial
  FontSize 11
  DiamondBackgroundColor #B2DFDB
  DiamondBorderColor #00695C
  ArrowColor #004D40
}

|Player|
start
:Buka widget chatbot\natau halaman /chat;
:Kirim pertanyaan;

|System|
:Simpan pesan user;
:Embed query\n(gemini-embedding-001);

|Gemini API|
:Kembalikan vector embedding;

|System|
:Hitung cosine similarity\nke chunks docs/*.md;
:Ambil 5 chunk paling relevan;
:Susun prompt + konteks;

|Gemini API|
:Generate balasan\n(gemini-2.5-flash);

|System|
:Simpan balasan + token usage;

|Player|
:Lihat balasan pada thread chat;
stop

@enduml
