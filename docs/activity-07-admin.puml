@startuml activity-07-admin
title Admin - Manage Data (Filament Panel)
skinparam activity {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
  FontName Arial
  FontSize 11
  DiamondBackgroundColor #E1BEE7
  DiamondBorderColor #6A1B9A
  ArrowColor #4A148C
}

|Admin|
start
:Login & akses /admin;

|System|
:Verifikasi role = admin;
if (Role admin?) then (ya)
  :Tampilkan Filament Dashboard;
else (tidak)
  :Tolak akses (403);
  stop
endif

|Admin|
:Pilih resource\n(Users / Sports / Venues /\nEvents / Participants);
:Create / Edit / Delete data;

|System|
:Validasi & simpan perubahan;

|Admin|
:Logout dari Admin Panel;
stop

@enduml
