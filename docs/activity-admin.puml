@startuml activity-admin
title Admin - Activity Diagram
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam ArrowFontSize 14
skinparam activity {
  FontSize 16
  FontName Arial
  DiamondFontSize 14
}

|Admin|
start
:Login ke sistem;
|System|
if (Validasi Login\n& role = admin?) then (Salah)
  :Tampilkan error / tolak (403);
  stop
else (Benar)
endif
:Akses Dashboard Admin;

|Admin|
if (Pilih menu) then (pilih salah satu)

  :Masuk halaman Users;
  |System|
  :Tampilkan halaman users;

  |Admin|
  :Kelola user (CRUD);
  |System|
  :Tampilkan users setelah diedit;

  |Admin|
  :Masuk halaman Sports;
  |System|
  :Tampilkan halaman sports;

  |Admin|
  :Kelola sport & skill levels (CRUD);
  |System|
  :Tampilkan sports setelah diedit;

  |Admin|
  :Masuk halaman Venues;
  |System|
  :Tampilkan halaman venues;

  |Admin|
  :Kelola venue (CRUD, set lokasi peta);
  |System|
  :Tampilkan venues setelah diedit;

  |Admin|
  :Masuk halaman Events;
  |System|
  :Tampilkan halaman events;

  |Admin|
  :Kelola event (CRUD);
  |System|
  :Tampilkan events setelah diedit;

  |Admin|
  :Masuk halaman Participants;
  |System|
  :Tampilkan halaman participants;

  |Admin|
  :Ubah status partisipasi;
  |System|
  :Tampilkan participants setelah diedit;

  |Admin|
  :Lihat Event Messages (read-only);
  |System|
  :Tampilkan daftar pesan;

  |Admin|
  :Logout;
  |System|
  :Sesi berakhir;
  stop

else ( )
endif
stop

note right
  "Pilih menu" mewakili seluruh resource
  Filament (Users, Sports, Venues, Events,
  Participants, Event Messages). Ditampilkan
  berurutan untuk menyederhanakan diagram.
  Logout dapat diakses dari halaman mana saja.
end note

@enduml
