@startuml activity-02-player-matchmaking
title Player - Matchmaking & Challenge
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontName Arial
  FontSize 11
  DiamondBackgroundColor #BBDEFB
  DiamondBorderColor #1565C0
  ArrowColor #0D47A1
}

|Player|
start
:Login & lihat Dashboard;
:Buka halaman Matchmaking;
:Atur filter (sport, skill, distance, time);

|System|
:Hitung skor kecocokan rule-based\n(sport, skill, time, distance, activity);
:Tampilkan kartu rekomendasi\n+ rincian skor per komponen;

if (Skor tertinggi >= 0.75\ndan sport sama?) then (ya)
  :Tampilkan overlay\n"Top Match Discovered";
else (tidak)
endif

|Player|
if (Klik "Challenge"?) then (ya)
  :Klik Challenge pada kartu pemain;
  |System|
  :Pre-fill form Create Event\ndengan lawan terpilih;
  |Player|
  :Lengkapi & submit form event;
  |System|
  :Simpan event;
  :Undang lawan sebagai\npending participant;
  stop
else (tidak)
  stop
endif

@enduml
