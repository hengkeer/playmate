@startuml activity-host
title Host - Activity Diagram
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam ArrowFontSize 14
skinparam activity {
  FontSize 16
  FontName Arial
  DiamondFontSize 14
}

|Host|
start
:Login ke sistem;
|System|
if (Validasi Login) then (Salah)
  :Tampilkan pesan error;
  stop
else (Benar)
endif
:Akses Dashboard;

|Host|
if (Pilih menu) then (pilih salah satu)

  :Klik "Create Event";
  :Isi form event;
  |System|
  :Simpan event, Host jadi\nparticipant pertama;

  |Host|
  :Lihat My Events (Hosted);
  |System|
  :Tampilkan daftar event;

  |Host|
  :Buka detail & lihat partisipan;
  |System|
  :Tampilkan daftar partisipan;

  |Host|
  :Buka Host Requests;
  |System|
  :Tampilkan permintaan join;

  |Host|
  if (Approve participant?) then (Ya)
    :Klik Approve;
    |System|
    :Set approved, assign slot;
  else (Tidak)
    |Host|
    :Klik Reject;
    |System|
    :Set rejected;
  endif

  |Host|
  :Batalkan event;
  |System|
  :Set status cancelled;

  |Host|
  :Logout;
  |System|
  :Sesi berakhir;
  stop

else ( )
endif
stop

note right
  Host adalah Player yang membuat event;
  seluruh fitur Player tetap tersedia.
  "Pilih menu" ditampilkan berurutan untuk
  menyederhanakan diagram. Logout dapat
  diakses dari halaman mana saja.
end note

@enduml
