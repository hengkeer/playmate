@startuml activity-06a-host-create-event
title Host - Create Event
skinparam activity {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontName Arial
  FontSize 11
  DiamondBackgroundColor #FFE0B2
  DiamondBorderColor #E65100
  ArrowColor #BF360C
}

|Host|
start
:Klik "Create Event";
:Isi form (sport, venue, slot,\nharga, visibility, approval_required);
:Submit form;

|System|
:Simpan data event;
:Host otomatis menjadi\nparticipant slot pertama;

|Participant|
:Klik "Join Event";

|System|
if (approval_required = true?) then (ya)
  :Set status pending;
else (tidak)
  :Set status approved\nsecara otomatis;
  |Participant|
  :Masuk Event Group Chat;
  stop
endif

@enduml
