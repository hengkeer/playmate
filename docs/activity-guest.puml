@startuml activity-guest
title Guest - Activity Diagram
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam ArrowFontSize 14
skinparam activity {
  FontSize 16
  FontName Arial
  DiamondFontSize 14
}

|Guest|
start
:Akses Landing Page;
|System|
:Tampilkan halaman utama;

|Guest|
if (Pilih menu) then (pilih salah satu)

  :Browse Events;
  |System|
  :Tampilkan list event;

  |Guest|
  :Akses detail event;
  |System|
  :Tampilkan detail event;

  |Guest|
  :Browse Venues;
  |System|
  :Tampilkan list venue;

  |Guest|
  :Akses detail venue;
  |System|
  :Tampilkan detail venue;

  |Guest|
  :Akses profil pemain (publik);
  |System|
  :Tampilkan profil publik pemain;

  |Guest|
  :Klik Connect / Join Event;
  |System|
  :Redirect ke halaman Login;

  |Guest|
  :Isi form Registrasi;
  |System|
  if (Data valid?) then (Benar)
    :Buat akun & auto-login;
  else (Salah)
    :Tampilkan error validasi;
  endif

  |Guest|
  :Login ke sistem;
  |System|
  if (Validasi Login) then (Benar)
    :Akses Dashboard;
    stop
  else (Salah)
    :Tampilkan pesan error;
    stop
  endif

else ( )
endif
stop

note right
  "Pilih menu" mewakili pilihan navigasi Guest
  (Browse Events, Browse Venues, Lihat Profil,
  Register, Login). Ditampilkan berurutan untuk
  menyederhanakan diagram.
end note

@enduml
